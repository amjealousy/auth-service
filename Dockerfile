

FROM golang:alpine AS builder

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /build

# Сначала копируем только файлы зависимостей
# Это позволяет кэшировать скачивание модулей, если код изменился, а go.mod - нет
COPY go.mod go.sum ./
RUN go mod download

# Копируем весь остальной исходный код
COPY . .

# Собираем бинарный файл приложения
# CGO_ENABLED=0 отключает использование C-библиотек (нужно для работы в чистом Alpine)
# GOOS=linux указывает целевую ОС
RUN CGO_ENABLED=0 GOOS=linux go build -o auth-service main.go

# ==========================================
# Этап 2: Финальный образ (Production)
# ==========================================
# Используем минималистичный образ для запуска
FROM alpine:latest

# Добавляем сертификаты (полезно, если сервис будет делать внешние HTTPS-запросы)
# и таймзоны (чтобы логи были с правильным временем)
RUN apk --no-cache add ca-certificates tzdata

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем собранный бинарник из первого этапа
COPY --from=builder /build/auth-service .

# Сообщаем Docker, какие порты использует контейнер
# 4888 - OIDC HTTP Server
# 5888 - SSO gRPC Server
EXPOSE 3000 4888 5888

# Команда для запуска нашего приложения
CMD ["./auth-service"]
